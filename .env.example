# Template for local development: copy to .env. The api and worker load .env
# on start without overriding variables that are already set. Values below
# are for local use only.

# development | production (anything but development runs Gin in release mode)
APP_ENV=development

# Address the API listens on
HTTP_ADDR=:8080

# PostgreSQL connection string: the `postgres16` container already running in
# Docker on the development machine, database `maki`. That server uses trust
# authentication, so the URL has no password.
DATABASE_URL=postgres://root@localhost:5432/maki?sslmode=disable

# PostgreSQL for integration tests (go test only; the binaries ignore it). Each
# test creates its own schema here and drops it when done, so the development
# database is safe to use. Empty skips those tests.
TEST_DATABASE_URL=postgres://root@localhost:5432/maki?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated exact origins that may call the API from a browser (maki-fe dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty trusts none
TRUSTED_PROXIES=

# Signs access tokens; at least 32 bytes, different in every environment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# The web app's origin, where the links in emails lead (password reset, email
# verification). Defaults to maki-fe's dev server in development only.
WEB_BASE_URL=http://localhost:3002

# Mail server for the worker's emails (password reset, email verification).
# Empty SMTP_HOST in development: the worker writes each email to its log
# instead of sending it. Outside development the worker refuses to start
# without it.
SMTP_HOST=
# 587 for starttls, 465 for tls
SMTP_PORT=587
# starttls | tls | none (development only, e.g. a local catcher like Mailpit)
SMTP_TLS=starttls
# Both empty when the server needs no login
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, as "Name <address>"
SMTP_FROM=Maki <no-reply@maki.local>
