# The backup bucket, apart from the app's buckets (spec: a pg_dump a day,
# kept 14–30 days by the bucket's lifecycle rule). Copy to
# /srv/maki/backup.env on the VPS; backup.sh uploads through the AWS CLI's
# container, which reads these. An access key for this bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# The S3-compatible endpoint, from the object storage's console, and the
# bucket's name.
BACKUP_ENDPOINT=
BACKUP_BUCKET=
