# The production stack's settings and secrets (compose.yaml): copy to
# /srv/maki/.env on the VPS and fill it in there. It never goes into a
# repository. docs/deployment.md says what each one is for.

# The domain the web app and the API share. Its DNS A (and AAAA) record points
# at the VPS; Caddy gets its certificate.
MAKI_DOMAIN=pos.example.com

# PostgreSQL's password, which the api's DATABASE_URL carries too: letters and
# digits only, so the URL needs no escaping. Generate one with
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs access tokens: at least 32 bytes, its own in every environment.
#   openssl rand -base64 48
JWT_SECRET=

# debug | info | warn | error
LOG_LEVEL=info

# Outgoing email through any SMTP provider: password resets and email
# confirmations. Outside development the worker won't start without it.
SMTP_HOST=
# 587 for starttls, 465 for tls
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender, as "Name <address>"
SMTP_FROM=Maki <no-reply@pos.example.com>

# Browser origins besides MAKI_DOMAIN that may call the API: none, as the web
# app is served from the same domain.
CORS_ALLOWED_ORIGINS=

# The object storage's origins, for the web app's CSP once menu photos come:
# the CDN in front of the public bucket, and the storage itself.
CDN_ORIGIN=
STORAGE_ORIGIN=
